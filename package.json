{
  "name": "koa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "koa: personal and community record-keeping for Australia that stays on one device. General information only.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "ocr:assets": "node scripts/copy-ocr-assets.mjs",
    "postinstall": "node scripts/copy-ocr-assets.mjs",
    "dev": "node scripts/copy-ocr-assets.mjs && vite",
    "build": "node scripts/copy-ocr-assets.mjs && tsc --noEmit && node scripts/rules-check.mjs && vite build && node scripts/rules-check.mjs --dist",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:rules": "node scripts/rules-check.mjs",
    "test": "node --test scripts/rules-check.test.mjs \"src/lib/**/*.test.ts\"",
    "test:smoke": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm run test && npm run check:rules"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@tanstack/react-router": "^1.170.46",
    "@tesseract.js-data/eng": "^1.0.0",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "playwright-core": "^1.65.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
